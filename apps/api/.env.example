BUILD_COST_ENVIRONMENT=development
BUILD_COST_DATABASE_URL=postgresql+psycopg://buildcost:buildcost@localhost:5432/buildcost
BUILD_COST_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
BUILD_COST_JWT_ISSUER=buildcost-pro
BUILD_COST_ACCESS_TOKEN_MINUTES=15
BUILD_COST_REFRESH_TOKEN_DAYS=30
BUILD_COST_VERIFICATION_TOKEN_MINUTES=30
BUILD_COST_RESET_TOKEN_MINUTES=30
BUILD_COST_LOGIN_MAX_ATTEMPTS=5
BUILD_COST_LOGIN_LOCK_MINUTES=15
BUILD_COST_ALLOWED_HOSTS=localhost,127.0.0.1
BUILD_COST_CORS_ORIGINS=http://localhost:3000
